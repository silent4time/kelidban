#!/usr/bin/env bash
# Kelidban server tool - usage: sudo kelidban <command>   (sudo kelidban help)
#   sudo kelidban menu   opens the interactive management menu (install.sh)
set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
APP="$(cd "$(dirname "$SELF")/.." && pwd)"
SRC="${KB_SRC:-/opt/kelidban-src}"

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Run as root:  sudo kelidban ${*:-help}"
  exit 1
fi

# Commands handled by the installer / management script
installer() {
  local s
  for s in "$SRC/install.sh" "$APP/install.sh"; do
    if [[ -f "$s" ]]; then
      exec bash "$s" --dir "$APP" "$@"
    fi
  done
  echo "[x] install.sh not found in $SRC or $APP"
  exit 1
}

case "${1:-}" in
  update|menu|check|selfcheck|doctor|ssl|renew|restart|logs|restore|uninstall|reset-password|install)
    cmd="$1"; shift
    [[ "$cmd" == "selfcheck" || "$cmd" == "doctor" ]] && cmd="check"
    installer "$cmd" "$@"
    ;;
esac

pick_php() {
  local p
  for p in php8.4 php8.3 php8.2 php8.1 php; do
    if command -v "$p" >/dev/null 2>&1 && "$p" -r 'exit(extension_loaded("pdo_sqlite") ? 0 : 1);' >/dev/null 2>&1; then
      echo "$p"
      return 0
    fi
  done
  return 1
}

PHP="$(pick_php)" || { echo "[x] No PHP with pdo_sqlite found (apt-get install php-sqlite3)"; exit 1; }

"$PHP" "$APP/bin/kelidban.php" "$@"
rc=$?
if [[ -d "$APP/storage" ]]; then
  chown -R "$(stat -c %U:%G "$APP/storage")" "$APP/storage"
fi
exit $rc
